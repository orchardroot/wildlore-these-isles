 "signs": [
  {
   "x": 19,
   "y": 23,
   "plaque": "channel_islands_tunnels",
   "title": "The War Tunnels",
   "text": "Begun in 1941 as an artillery barracks and workshop, a maze of tunnels dug into the hill at St Lawrence by forced labourers brought from across occupied Europe, many of them starved and badly treated. Late in the war the tunnels became an emergency hospital. Today they are a museum of the Occupation, and a memorial to the workers who died."
  },
  {
   "x": 35,
   "y": 30,
   "plaque": "channel_islands_hougue",
   "title": "La Hougue Bie",
   "text": "A great Neolithic passage tomb under a grassy mound, built about 6,000 years ago, among the largest in Europe. At the spring and autumn equinox the sunrise lights the passage right to the back. A medieval chapel stands on top, and the Germans built a bunker beside it."
  },
  {
   "x": 45,
   "y": 47,
   "plaque": "channel_islands_orgueil",
   "title": "Mont Orgueil",
   "text": "Built after 1204, when King John lost Normandy and the Channel Islands became England's front line, to guard Gorey harbour and the French coast just fifteen miles away. Mont Orgueil means Mount Pride. It stood for four centuries until cannon made it out of date, and Elizabeth Castle replaced it."
  },
  {
   "x": 53,
   "y": 14,
   "plaque": "channel_islands_durrell",
   "theme": "arts",
   "title": "Durrell Wildlife Park",
   "text": "Gerald Durrell, the writer of My Family and Other Animals, founded the zoo at Les Augr\u00e8s Manor in 1959 to breed endangered species and save them from extinction. The Durrell Trust's logo is a dodo, as a reminder of what happens when nobody tries. It has helped save the pink pigeon, the mountain chicken frog and golden lion tamarins."
  },
  {
   "x": 7,
   "y": 33,
   "plaque": "channel_islands_cow",
   "title": "The Jersey Cow",
   "text": "Small, fawn-coloured, with huge dark eyes, and a milk so rich in cream it makes the best butter in the world. The island has kept the breed pure for more than two centuries: bringing in cattle of any other kind has been banned since 1789."
  },
  {
   "x": 51,
   "y": 23,
   "plaque": "channel_islands_towers",
   "title": "The Round Towers",
   "text": "Jersey is ringed with granite round towers, built from the 1780s to guard against the French. Some stand on the shore, some on the tidal flats, and at low water you can walk to Seymour Tower across a mile of sand, if you check the tide first."
  },
  {
   "x": 27,
   "y": 43,
   "plaque": "channel_islands_royals",
   "title": "Jersey Royals",
   "text": "The island's first potatoes of the season, grown in steep, south-facing fields and picked by hand from April, long before anywhere else. The seaweed called vraic is traditionally spread on the fields as fertiliser. The Jersey Royal has protected status, like champagne or Stilton."
  },
  {
   "x": 17,
   "y": 8,
   "plaque": "channel_islands_bouley",
   "title": "Bouley Bay",
   "text": "A steep bay on the north coast, where old Jersey stories put a ghostly black dog that walks the cliff path after dark. In J\u00e8rriais, tchian means dog. The hillclimb road above the bay is also used for motor racing, which is quite loud for a ghost to compete with."
  },
  {
   "x": 56,
   "y": 14,
   "plaque": "channel_islands_grouville",
   "title": "Royal Bay of Grouville",
   "text": "The long sweep of sand on the east coast, where the tide goes out a mile or more on the biggest days. The shore is also home to oyster beds. Oysters have been farmed in Gorey since the nineteenth century, and Jersey ones are sold fresh on the harbour."
  },
  {
   "x": 38,
   "y": 36,
   "plaque": "channel_islands_jersey_lanes",
   "title": "Green Lanes",
   "text": "Jersey has a network of narrow green lanes, signed with a speed limit of 15 miles an hour, where walkers, cyclists and horses have priority over cars. The lanes were traced by farmers' carts and hardly any have a straight line."
  },
  {
   "x": 29,
   "y": 52,
   "text": "SOUTH: St Helier. EAST at the crossroads: Gorey and Mont Orgueil. NORTH: Durrell, and the cliff path along the north coast."
  },
  {
   "x": 29,
   "y": 24,
   "text": "WEST: the Jersey War Tunnels at St Lawrence. EAST: La Hougue Bie, the great mound."
  }
 ],
