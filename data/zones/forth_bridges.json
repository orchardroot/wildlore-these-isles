 "signs": [
  {
   "x": 41,
   "y": 46,
   "plaque": "fife_forth_bridge",
   "title": "The Forth Bridge",
   "text": "Opened on 4 March 1890: a cantilever railway bridge about two and a half kilometres long, built from some 54,000 tonnes of steel. For years it had the longest spans in the world, and since 2015 it has been a UNESCO World Heritage Site."
  },
  {
   "x": 47,
   "y": 46,
   "plaque": "fife_painting_forth",
   "title": "Painting the Forth Bridge",
   "text": "A job that never ends, says the saying: by the time the painters reached one end, the other end needed doing again. A new coat finished in 2011 should last at least twenty-five years, so the saying is having a rest."
  },
  {
   "x": 29,
   "y": 46,
   "plaque": "fife_road_bridge",
   "title": "The Forth Road Bridge",
   "text": "A suspension bridge opened by the Queen in 1964, for a while the longest of its kind outside America. Since the Queensferry Crossing opened beside it in 2017 it carries buses, bikes and people on foot. Like you."
  },
  {
   "x": 19,
   "y": 46,
   "plaque": "fife_queensferry_crossing",
   "title": "The Queensferry Crossing",
   "text": "Opened in 2017, the longest three-tower cable-stayed bridge in the world. Stand here and you can see bridges from three different centuries, all doing the same job."
  },
  {
   "x": 59,
   "y": 46,
   "plaque": "fife_inchcolm",
   "title": "Inchcolm",
   "text": "The island out in the firth holds Inchcolm Abbey, sometimes called the Iona of the East, the best-preserved medieval monastery in Scotland. Grey seals haul out on the rocks round it."
  },
  {
   "x": 2,
   "y": 9,
   "plaque": "fife_culross",
   "title": "Culross",
   "text": "In the 1500s and 1600s Culross grew rich on coal and salt, then trade moved away and the little town went quiet, which is why its cobbled wynds and red-roofed houses survive. The National Trust for Scotland has cared for it since the 1930s."
  },
  {
   "x": 12,
   "y": 10,
   "plaque": "fife_crown_causey",
   "title": "The Crown of the Causey",
   "text": "The raised strip down the middle of Culross's cobbled street was kept for the gentry. Everyone else walked at the sides, nearer the gutter. Walk where you like; nobody is checking."
  },
  {
   "x": 29,
   "y": 10,
   "plaque": "fife_coastal_path",
   "title": "The Fife Coastal Path",
   "text": "Over a hundred miles of footpath round the Kingdom of Fife, from the Forth bridges to the Tay. Fife has called itself the Kingdom for centuries, and Robert the Bruce is buried in Dunfermline Abbey."
  },
  {
   "x": 24,
   "y": 54,
   "plaque": "fife_burry_man",
   "title": "The Burry Man",
   "text": "On the second Friday in August a South Queensferry man is covered head to toe in sticky burdock burrs and walks round the town all day, sipping whisky through a straw. Nobody knows quite why, which is the best kind of custom."
  },
  {
   "x": 28,
   "y": 67,
   "text": "NORTH: The Forth Road Bridge, Fife, St Andrews. SOUTH: Edinburgh."
  },
  {
   "x": 28,
   "y": 2,
   "text": "SOUTH: The Forth bridges, Edinburgh. NORTH: St Andrews, then over the Tay to Dundee."
  }
 ],
