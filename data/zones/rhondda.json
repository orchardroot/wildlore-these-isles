 "signs": [
  {
   "x": 27,
   "y": 66,
   "text": "YR RHONDDA. Croeso! (Welcome!) Two valleys, Fawr (big) and Fach (little). South: Caerdydd, Cardiff. North: Merthyr Tydfil."
  },
  {
   "x": 27,
   "y": 4,
   "text": "MERTHYR TYDFIL, ahead. The iron capital of the world, once. Mind the hill, bach."
  },
  {
   "x": 22,
   "y": 30,
   "text": "Y GLO. 'Coal.' Every back yard along this river once had a tip behind it. The river ran black; it runs clear now, and the dippers have noticed."
  },
  {
   "x": 27,
   "y": 62,
   "plaque": "rhondda_cwm",
   "title": "Cwm and Rhondda",
   "text": "A cwm (say 'coom') is a steep-sided valley, and the south Wales coalfield is a comb of them running down to the sea. The Rhondda is two: Fawr, big, and Fach, little, which meet at Porth. A hundred and fifty years ago most of it was sheep and woodland."
  },
  {
   "x": 27,
   "y": 50,
   "plaque": "rhondda_coal",
   "title": "Black Gold",
   "text": "In 1913 the south Wales coalfield dug a record 56 million tons, and the Rhondda alone had dozens of pits. Steam coal from here drove ships all over the world, and Cardiff was the busiest coal port on earth."
  },
  {
   "x": 27,
   "y": 38,
   "plaque": "rhondda_terraces",
   "title": "Terraces",
   "text": "In 1851 the Rhondda held a few thousand people. By 1911 it held over 150,000. Rows of stone houses were thrown up along the contours so that men could walk from bed to the pit, and every one had a chimney, a back yard and a chapel within shouting distance."
  },
  {
   "x": 27,
   "y": 26,
   "plaque": "rhondda_choirs",
   "theme": "arts",
   "title": "Male Voice Choirs",
   "text": "The valleys' male voice choirs grew out of the chapels and the pits, where hundreds of men were used to singing in harmony. A choir might rehearse twice a week and compete at the eisteddfod, and some of them are over a hundred years old."
  },
  {
   "x": 27,
   "y": 14,
   "plaque": "rhondda_calon",
   "title": "Calon Lan",
   "text": "'Calon Lan', 'a pure heart', is a hymn with words by Daniel James and a tune by John Hughes, and it is sung by Welsh choirs, chapels and rugby crowds with equal conviction. Nobody sings the second verse, but everybody knows it."
  },
  {
   "x": 27,
   "y": 8,
   "plaque": "rhondda_tips",
   "title": "The Tips",
   "text": "Spoil from the pits was piled in great tips on the hillsides. Many have since been reshaped, grassed and planted, and walkers now cross slopes that were once black. The valley sides are green again, which makes the old photographs look like another country."
  },
  {
   "x": 22,
   "y": 36,
   "plaque": "rhondda_aberfan",
   "title": "Aberfan, 1966",
   "text": "In memory of the 144 people who died at Aberfan on 21 October 1966, 116 of them children. Remembered."
  }
 ],
