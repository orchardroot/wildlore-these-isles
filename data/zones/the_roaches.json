 "signs": [
  {
   "x": 35,
   "y": 1,
   "text": "PUBLIC FOOTPATH. South: the Roaches, Rudyard Lake and Leek, then the Potteries. Please close all gates. Sheep do not close gates."
  },
  {
   "x": 28,
   "y": 55,
   "text": "SOUTH: Stoke-on-Trent, the six towns of the Potteries. NORTH: Macclesfield, 9 miles of hills."
  },
  {
   "x": 51,
   "y": 18,
   "plaque": "potteries_hanging_stone",
   "title": "The Hanging Stone",
   "text": "A great block of gritstone jutting out over the hillside like a shelf nobody dares put anything on. Two memorial plaques are fixed to it: one to a Brocklehurst of Swythamley killed in the Second World War, and an older one to a much-loved dog."
  },
  {
   "x": 32,
   "y": 20,
   "plaque": "potteries_the_roaches",
   "title": "The Roaches",
   "text": "The name comes from the French 'roches', rocks. The gritstone here was laid down by great rivers about 320 million years ago, then tilted up and worn into these edges. Today it is one of the best-loved climbing crags in England."
  },
  {
   "x": 48,
   "y": 31,
   "plaque": "potteries_doxey_pool",
   "title": "Doxey Pool",
   "text": "A small dark pool on top of the Roaches that never seems to dry out. Local legend says a water spirit lives in it and drags the unwary under. A reasonable view of anyone who goes swimming up here in March."
  },
  {
   "x": 15,
   "y": 19,
   "plaque": "potteries_rudyard_lake",
   "title": "Rudyard Lake",
   "text": "Built in the 1790s as a reservoir to top up the Caldon Canal. In 1863 John Kipling and Alice Macdonald met at a picnic here, married, and named their first son after the lake: Rudyard Kipling, author of The Jungle Book."
  },
  {
   "x": 24,
   "y": 46,
   "plaque": "potteries_tittesworth",
   "title": "Tittesworth Reservoir",
   "text": "Holds water for the Potteries, and a great many ducks. Dammed in the 1850s and made much bigger in the 1960s. On a still day the Roaches stand upside down in it."
  },
  {
   "x": 32,
   "y": 41,
   "plaque": "potteries_rockhall",
   "title": "Rockhall Cottage",
   "text": "A little cottage squeezed into the rocks at the foot of the crag. It is now a climbers' hut named after Don Whillans, one of the great gritstone climbers of the 1950s."
  },
  {
   "x": 54,
   "y": 26,
   "text": "THE ROACHES. Trig point. On a clear day you can see Snowdonia, apparently. On a normal day you can see the next bit of fog."
  },
  {
   "x": 51,
   "y": 4,
   "text": "LUD'S CHURCH. A deep cleft in the hillside. Mind your step, mind your head, and mind the gentleman in green if he offers you a game."
  }
 ],
