 "signs": [
  {
   "x": 12,
   "y": 18,
   "text": "MACCLESFIELD FOREST. Mind the pines. Mind the herons. Mostly mind the herons."
  },
  {
   "x": 44,
   "y": 11,
   "text": "EAST: Cat and Fiddle road. Moorland ahead. Weather: yes."
  },
  {
   "x": 16,
   "y": 12,
   "text": "TRENTABANK HERONRY. Please do not argue with the herons."
  },
  {
   "x": 36,
   "y": 8,
   "plaque": "macc_forest_royal_forest",
   "title": "A Royal Forest",
   "text": "In the Middle Ages this was a royal hunting forest, run under strict forest law for the Earls of Chester and later the Crown. 'Forest' meant land kept for deer, not trees: most of it was open moor. The conifers you see now were planted much later, round the reservoirs."
  },
  {
   "x": 40,
   "y": 26,
   "plaque": "macc_forest_rushbearing",
   "title": "Forest Chapel",
   "text": "Up the lane stands Forest Chapel, a little stone church high on the moor. Every August it holds a rushbearing: fresh rushes are strewn on the floor and woven into patterns, as churches did when floors were bare earth and very cold. Few places in England still keep the custom."
  }
 ],
