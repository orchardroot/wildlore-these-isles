 "signs": [
  {
   "x": 30,
   "y": 21,
   "plaque": "abroad_bristol_state_line",
   "title": "The State Line",
   "text": "Bristol is two towns, one in Tennessee and one in Virginia, and the state line runs down the middle of State Street. You can stand with one foot in each. The famous sign over the street says: Bristol VA-TN, A Good Place to Live."
  },
  {
   "x": 7,
   "y": 18,
   "plaque": "abroad_bristol_sessions",
   "title": "The Bristol Sessions",
   "text": "In the summer of 1927 Ralph Peer of the Victor Talking Machine Company set up a recording studio here and invited local musicians in. Among them were the Carter Family and Jimmie Rodgers. Country music grew from those recordings, and in 1998 the US Congress named Bristol the Birthplace of Country Music."
  },
  {
   "x": 25,
   "y": 26,
   "plaque": "abroad_bristol_ulster_scots",
   "title": "From Ulster to the Mountains",
   "text": "In the 1700s tens of thousands of Presbyterians from Ulster, descended from Scots who had settled there in the 1600s, sailed to America. They were escaping rising rents, bad harvests and laws that barred them from public office. In America they were called the Scotch-Irish."
  },
  {
   "x": 39,
   "y": 18,
   "plaque": "abroad_bristol_wagon_road",
   "title": "The Great Wagon Road",
   "text": "Most landed at Philadelphia, then went west and south down the Great Wagon Road, through the Shenandoah Valley into the backcountry of Virginia, the Carolinas and Tennessee. They cleared farms in the hollows and kept their kirk, their tunes and their independence."
  },
  {
   "x": 18,
   "y": 26,
   "plaque": "abroad_bristol_words",
   "title": "Redd Up",
   "text": "Some Scots and Ulster words crossed with them. To redd up means to tidy, in Ulster and in the mountains alike. A poke is a paper bag. Language travels light and lasts a long time."
  },
  {
   "x": 47,
   "y": 26,
   "plaque": "abroad_bristol_ballads",
   "title": "Ballads in the Hills",
   "text": "Old English and Scottish ballads were still being sung in these mountains long after they faded at home. Between 1916 and 1918 the English folk song collector Cecil Sharp, with Maud Karpeles, wrote down hundreds of songs and tunes in the southern Appalachians."
  },
  {
   "x": 34,
   "y": 26,
   "plaque": "abroad_bristol_banjo",
   "title": "The Banjo",
   "text": "The fiddle came from Scotland, Ireland and England. The banjo came from Africa: enslaved Africans brought the idea of the gourd-bodied, skin-headed lute with them. Old-time and country music grew out of all of them playing together, and that mix is the heart of it."
  },
  {
   "x": 52,
   "y": 18,
   "plaque": "abroad_bristol_jackson",
   "title": "Andrew Jackson",
   "text": "Andrew Jackson's parents left Boneybefore, near Carrickfergus in County Antrim, for the Carolinas in 1765, and he was born there two years later. He became the seventh President of the United States. A cottage at Boneybefore now tells the family story."
  }
 ],
