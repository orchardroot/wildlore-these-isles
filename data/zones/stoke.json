 "signs": [
  {
   "x": 38,
   "y": 2,
   "text": "STOKE-ON-TRENT. The Potteries. Six towns, one city, a great many teapots. Twinned with nowhere, as everywhere else is too far from an oatcake."
  },
  {
   "x": 35,
   "y": 15,
   "text": "HIGH STREET. West: Spode Works, Potteries Museum. East: Middleport, the Leopard. South: canal, Gladstone, the Ground. North: the Roaches and Macclesfield."
  },
  {
   "x": 38,
   "y": 53,
   "text": "CENTRAL FOREST PARK. No forest, but give it time. Dogs on leads near the ducks, please."
  },
  {
   "x": 16,
   "y": 12,
   "plaque": "potteries_hoard",
   "people": "anglo_saxons",
   "title": "The Staffordshire Hoard",
   "text": "In 2009 a metal detectorist in a field near Lichfield found the largest hoard of Anglo-Saxon gold and silver ever discovered: over 3,500 pieces, most of them fittings torn from swords and helmets. Much of it is on show in the Potteries Museum in Hanley."
  },
  {
   "x": 3,
   "y": 12,
   "plaque": "potteries_spitfire",
   "title": "Reginald Mitchell",
   "text": "Reginald Mitchell, born in 1895 near Kidsgrove and brought up in the Potteries, designed the Spitfire. It first flew in 1936; he died the next year, aged 42, before it went to war. A Spitfire is on show in the Potteries Museum in his honour."
  },
  {
   "x": 35,
   "y": 18,
   "plaque": "potteries_six_towns",
   "title": "Six Towns, One City",
   "text": "Tunstall, Burslem, Hanley, Stoke, Fenton and Longton joined up in 1910 as one borough, which became the City of Stoke-on-Trent in 1925. Locals still say which town they are from first."
  },
  {
   "x": 57,
   "y": 12,
   "plaque": "potteries_arnold_bennett",
   "theme": "arts",
   "title": "Arnold Bennett",
   "text": "The novelist Arnold Bennett was born in Hanley in 1867. He wrote the Potteries into Anna of the Five Towns and Clayhanger, renaming the towns as he went. There are six towns; he left out Fenton, which Fenton has not forgotten."
  },
  {
   "x": 68,
   "y": 12,
   "plaque": "potteries_wedgwood",
   "title": "Josiah Wedgwood",
   "text": "Josiah Wedgwood, born in Burslem in 1730, built his Etruria works beside the new canal so that his pots could travel smoothly. His jasperware, white figures on soft blue, is still made. His grandson was Charles Darwin."
  },
  {
   "x": 30,
   "y": 25,
   "plaque": "potteries_trent_mersey",
   "title": "The Trent and Mersey Canal",
   "text": "Planned by the engineer James Brindley and championed by Wedgwood, it opened in 1777 and linked the Trent to the Mersey across the middle of England. Clay came in by boat and finished pottery went out, far less broken than by cart."
  },
  {
   "x": 25,
   "y": 31,
   "plaque": "potteries_bottle_ovens",
   "title": "Bottle Ovens",
   "text": "Bottle-shaped kilns once crowded the Potteries skyline, around 2,000 of them, firing day and night and filling the streets with smoke. Clean air laws ended coal firing, and only a few dozen survive. These are Gladstone's."
  },
  {
   "x": 6,
   "y": 42,
   "plaque": "potteries_gladstone",
   "title": "Gladstone Pottery Museum",
   "text": "A complete Victorian potbank in Longton, with its bottle ovens, workshops and yard kept just as they were. It also holds a gallery on the history of the flushing toilet, because Stoke made a great many of those too."
  },
  {
   "x": 45,
   "y": 25,
   "plaque": "potteries_middleport",
   "title": "Middleport Pottery",
   "text": "A working pottery since 1888, beside the canal at Burslem, still making blue and white Burleigh ware by hand with a steam engine and a bottle oven on site. Boats used to tie up outside to load the crates."
  },
  {
   "x": 10,
   "y": 20,
   "plaque": "potteries_spode",
   "title": "Spode",
   "text": "Josiah Spode's works in Stoke perfected fine bone china around 1800, adding ox bone ash to the clay for a white, strong, glowing body. Spode's blue Italian pattern has been in production since 1816."
  },
  {
   "x": 38,
   "y": 20,
   "plaque": "potteries_leopard",
   "title": "The Leopard",
   "text": "A Burslem coaching inn. In 1765 Josiah Wedgwood and James Brindley are said to have met here to plan the canal that would carry the Potteries' wares to the world."
  },
  {
   "x": 53,
   "y": 31,
   "plaque": "potteries_stanley_matthews",
   "title": "Sir Stanley Matthews",
   "text": "Born in Hanley in 1915, the 'Wizard of Dribble' played for Stoke City and Blackpool and kept playing top-flight football until he was 50. In 1965 he became the first footballer to be knighted."
  },
  {
   "x": 42,
   "y": 44,
   "plaque": "potteries_oatcakes",
   "title": "Staffordshire Oatcakes",
   "text": "Not the crunchy Scottish kind. A Staffordshire oatcake is a soft, floppy pancake of oatmeal and flour raised with yeast, cooked on a hot plate and rolled round cheese, bacon or sausage. Shops used to sell them through a window straight onto the street."
  },
  {
   "x": 33,
   "y": 47,
   "plaque": "potteries_forest_park",
   "title": "Central Forest Park",
   "text": "Laid out in the 1970s over the spoil heaps of Hanley Deep Pit colliery. Coal and clay sat side by side under the Potteries, which is exactly why the potters came here."
  }
