 "signs": [
  {
   "x": 35,
   "y": 56,
   "plaque": "shetland_sumburgh",
   "title": "Sumburgh Head",
   "text": "Sumburgh Head lighthouse was built in 1821 to a design by Robert Stevenson, one of the famous family of lighthouse engineers, to guard the dangerous waters where the North Sea meets the Atlantic. Today it is a nature reserve, and from May to August the cliffs are crowded with puffins, guillemots and fulmars."
  },
  {
   "x": 24,
   "y": 33,
   "plaque": "shetland_jarlshof",
   "title": "Jarlshof",
   "text": "Jarlshof was a settlement for about four thousand years, from Bronze Age round houses to Iron Age brochs, Norse longhouses and a medieval farm. A storm in the 1890s stripped away the dune and revealed it all. The name comes from Walter Scott's 1822 novel The Pirate, and it stuck."
  },
  {
   "x": 44,
   "y": 26,
   "plaque": "shetland_mousa",
   "title": "Mousa Broch",
   "text": "On the little island of Mousa across the sound stands the best-preserved broch in the world, about thirteen metres tall, built over two thousand years ago. It is mentioned in a Norse saga, where two runaway lovers hole up inside. Today storm petrels nest in the stonework on summer nights."
  },
  {
   "x": 8,
   "y": 17,
   "plaque": "shetland_st_ninians",
   "title": "St Ninian's Isle",
   "text": "St Ninian's Isle is joined to the Mainland by a tombolo, a curving ridge of sand, one of the finest in Britain. In 1958 a schoolboy found a hoard of silver under a slab in the ruined chapel: bowls, brooches and a sword chape, probably hidden around 800 AD. The originals are in Edinburgh."
  },
  {
   "x": 38,
   "y": 45,
   "plaque": "shetland_runway",
   "title": "The Runway Crossing",
   "text": "At Sumburgh, the main road across the south of the Mainland crosses the airport runway. When a plane is due, barriers come down and the road is closed. It is one of the few roads in Britain where you can be held up by a Saab."
  },
  {
   "x": 35,
   "y": 3,
   "text": "NORTH: Lerwick, the museum and the Victoria Pier. SOUTH: Jarlshof, Sumburgh Airport and Sumburgh Head. Please close the gate; ponies have no sense of direction."
  }
 ],
