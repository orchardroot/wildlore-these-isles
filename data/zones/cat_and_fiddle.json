 "signs": [
  {
   "x": 29,
   "y": 13,
   "text": "THE CAT AND FIDDLE. Second highest pub in England. Closed for refurbishment, open for weather."
  },
  {
   "x": 3,
   "y": 9,
   "text": "A537. Exposed moorland road. Fog likely. Herons unlikely."
  },
  {
   "x": 60,
   "y": 20,
   "text": "BUXTON 1 mile. Spa town. Hot water, cold wind."
  },
  {
   "x": 23,
   "y": 13,
   "text": "PRIVATE: NO ROAMING. By order of the Enclosure. (Roaming is also discouraged.)"
  },
  {
   "x": 23,
   "y": 13,
   "text": "PRIVATE: NO ROAMING. By order of the Enclosure. (Roaming is also discouraged.)"
  },
  {
   "x": 46,
   "y": 8,
   "plaque": "cat_and_fiddle_red_grouse",
   "title": "Red Grouse",
   "text": "That chuckling 'go-back, go-back, go-back' from the heather is a red grouse. They live on young heather shoots, which is why the moors are burned in patches to keep the heather fresh. A grouse stays on its moor all year round, which in this weather shows real commitment."
  },
  {
   "x": 10,
   "y": 20,
   "plaque": "cat_and_fiddle_mountain_hare",
   "title": "Mountain Hares",
   "text": "The Peak District has England's only wild mountain hares. They were brought here from Scotland in Victorian times for sport, and stayed. In winter they turn white to hide in the snow, which works brilliantly in a snowy year and makes them stand out like a lost glove in a mild one."
  }
 ],
