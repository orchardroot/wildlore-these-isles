": "angu_home", "name": "Airport Official"}, {"id": "angu_skipper", "sprite": "sailor", "x": 43, "y": 24, "facing": "left", "move": "still", "trainer": "angu_skipper"}, {"id": "angu_crew", "sprite": "surfer", "x": 36, "y": 24, "facing": "down", "move": "still", "trainer": "angu_crew"}, {"id": "angu_fisher_t", "sprite": "fisher", "x": 37, "y": 30, "facing": "up", "move": "still", "trainer": "angu_fisher_t"}, {"id": "angu_salt_t", "sprite": "steelworker", "x": 67, "y": 26, "facing": "left", "move": "still", "trainer": "angu_salt_t"}, {"id": "angu_rival", "sprite": "sailor", "x": 44, "y": 19, "facing": "down", "move": "still", "trainer": "angu_rival"}, {"id": "angu_para", "sprite": "warden_grunt", "x": 51, "y": 21, "facing": "left", "move": "still", "trainer": "angu_para"}, {"id": "anguilla_bureau", "sprite": "commuter", "x": 44, "y": 26, "facing": "down", "move": "still", "script": "anguilla_bureau", "name": "Bureau Clerk"}, {"id": "anguilla_homebound", "sprite": "sailor", "x": 45, "y": 26, "facing": "down", "move": "still", "script": "anguilla_homebound", "name": "Movements Clerk"}], "encounters": {"grass": [{"species": "saltcrust", "min": 95, "max": 97, "weight": 12}, {"species": "sloopling", "min": 95, "max": 97, "weight": 14}, {"species": "flamingale", "min": 95, "max": 97, "weight": 8}, {"species": "chipgull", "min": 95, "max": 97, "weight": 14}, {"species": "duneskink", "min": 95, "max": 97, "weight": 14, "weather": ["clear", "sunshine"]}, {"species": "pinchkin", "min": 95, "max": 97, "weight": 12}, {"species": "ternlet", "min": 95, "max": 97, "weight": 10}, {"species": "gannetling", "min": 95, "max": 97, "weight": 8}, {"species": "croakle", "min": 95, "max": 97, "weight": 8}, {"species": "wideling", "min": 95, "max": 97, "weight": 10}, {"species": "parakit", "min": 95, "max": 97, "weight": 6, "weather": ["clear", "sunshine"]}, {"species": "swiftlet", "min": 95, "max": 97, "weight": 8, "weather": ["gale", "clear"]}], "water": [{"species": "sloopling", "min": 95, "max": 97, "weight": 24}, {"species": "dolphlet", "min": 95, "max": 97, "weight": 22}, {"species": "pinchkin", "min": 95, "max": 97, "weight": 16}, {"species": "swelklet", "min": 95, "max": 97, "weight": 16}, {"species": "plungebeak", "min": 95, "max": 97, "weight": 14}, {"species": "sloopracer", "min": 96, "max": 98, "weight": 6}]}, "signs": [{"x": 45, "y": 27, "text": "THE VALLEY, ANGUILLA. Capital of an island sixteen miles long and three wide. Drive on the left. The goats drive where they like."}, {"x": 29, "y": 23, "text": "SANDY GROUND. Boats, bars and a very good grilled lobster. Race day is the thirtieth of May and the whole island turns out."}, {"x": 70, "y": 25, "text": "THE SALT PONDS. Do not walk on the crust unless you're a flamingo. Or a salt raker."}, {"x": 46, "y": 31, "text": "FOUNTAIN CAVERN, a sacred cave of the Amerindian people. Lights are provided. Respect is also provided."}, {"x": 25, "y": 19, "text": "THE EEL. Anguilla means eel, in Spanish and French, for the island's long thin shape: about sixteen miles from end to end and three across at the widest. It is a flat coral limestone island, with no volcano and no mountains. Highest point: a gentle hill.", "plaque": "angu_name", "title": "The Eel"}, {"x": 49, "y": 23, "text": "THREE DOLPHINS. Anguilla's badge shows three dolphins in a circle, standing for endurance, unity and strength. The dolphins have been through a lot.", "plaque": "angu_dolphins", "title": "Three Dolphins"}, {"x": 36, "y": 23, "text": "ANGUILLA DAY. On 30 May 1967 the people of Anguilla expelled the St Kitts police from the island, after being placed under the government of St Kitts and Nevis against their wishes. The date is still celebrated as Anguilla Day.", "plaque": "angu_1967", "title": "Anguilla Day"}, {"x": 29, "y": 24, "text": "THE BLOODLESS INVASION. In March 1969, British paratroopers and London police landed in Anguilla to restore order. The press called it an invasion. The islanders greeted them in good humour. Nobody was killed, and the island has dined out on it since.", "plaque": "angu_1969", "title": "The Bloodless Invasion"}, {"x": 49, "y": 22, "text": "SEPARATE AT LAST. After years under British direct rule, Anguilla formally separated from St Kitts and Nevis in 1980 and became its own British Overseas Territory, which it remains today, with its own ministers and its own sense of humour.", "plaque": "angu_1980", "title": "Separate at Last"}, {"x": 40, "y": 21, "text": "BOAT RACING. Boat racing is Anguilla's national sport. Wooden sloops with enormous sails race round the bay, and the crew sit on long planks stuck out over the water to balance them. Big races are held on Anguilla Day and at the August carnival.", "plaque": "angu_boat_racing", "title": "Boat Racing"}, {"x": 66, "y": 25, "text": "SALT PONDS. The island's shallow salt ponds once supplied one of Anguilla's few exports. Sea water was let in, baked by the sun and raked into heaps. Today the ponds are a wildlife refuge, and flamingos and herons stalk the margins.", "plaque": "angu_salt", "title": "Salt Ponds"}, {"x": 56, "y": 21, "text": "WALLBLAKE HOUSE. Built about 1787, Wallblake House is the oldest surviving plantation house in Anguilla and one of the finest examples in the eastern Caribbean. It looks over the Valley, and its cistern and kitchen are still in the yard.", "plaque": "angu_wallblake", "title": "Wallblake House"}, {"x": 43, "y": 30, "text": "FOUNTAIN CAVERN. Amerindian people carved a stalagmite in this cave into a sacred figure and used it as a ceremonial site. Today it is a national park, with a spring-fed pool deep inside.", "plaque": "angu_fountain", "title": "Fountain Cavern"}, {"x": 70, "y": 23, "text": "SOMBRERO. Sombrero is Spanish for hat, and the flat island of that name lies far to the north-west, belonging to Anguilla. It has a lighthouse that dates from 1868 and no permanent inhabitants but seabirds.", "plaque": "angu_sombrero", "title": "Sombrero"}, {"x": 79, "y": 20, "text": "SHOAL BAY. Shoal Bay East is often ranked among the best beaches in the Caribbean: two miles of white sand, calm blue water and a coral reef close enough to snorkel from the shore.", "plaque": "angu_shoal_bay", "title": "Shoal Bay"}, {"x": 58, "y": 25, "text": "THE EC DOLLAR. Anguilla uses the Eastern Caribbean dollar, shared with a number of nearby islands and fixed at 2.70 to the US dollar. It's useful in the Valley, and in no other country at all, as the taxi drivers will tell you.", "plaque": "angu_dollar", "title": "The EC Dollar"}], "legend_extra": {"_water": {"deep": "#0a5e88", "deep_top": "#3cc2d2", "shallow": "#58dcd0"}, "$": {"tile": "sea", "colour": "#12829f"}, "~": {"tile": "water", "colour": "#33b4c0"}, "w": {"tile": "shallow", "colour": "#88e4d6"}, ".": {"tile": "grass", "colour": "#9db04a"}, ",": {"tile": "tall_grass", "colour": "#879a40", "prop": "short"}, "s": {"tile": "sand", "colour": "#f8f0da"}, "p": {"tile": "sand", "colour": "#faf3e0"}, "t": {"tile": "tree_oak", "prop": "palm"}, "e": {"tile": "tree_oak", "prop": "palm"}, "r": {"tile": "rock", "colour": "#c9c1ac"}, "b": {"tile": "shallow", "colour": "#d8c9d2"}, "n": {"tile": "sand", "colour": "#f4f6f4"}, "#": {"tile": "path", "colour": "#eadcbc"}, "=": {"tile": "road", "colour": "#c4bca6"}, ":": {"tile": "cobbles", "colour": "#dccfb4"}, "f": {"tile": "flowers", "colour": "#9db04a"}}, "rows": ["$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$", "$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$", "$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$", "$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$", "$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$", "$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$", "$$$$$$$$$$$$