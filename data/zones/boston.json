 "signs": [
  {
   "x": 40,
   "y": 29,
   "plaque": "abroad_boston_memorial",
   "title": "Boston Irish Famine Memorial",
   "text": "Unveiled in 1998, 150 years after the worst of the Famine. One group of figures shows a family starving in Ireland; the other, a family stepping ashore in Boston, thin but looking up. Between them is the whole story of a people."
  },
  {
   "x": 34,
   "y": 26,
   "plaque": "abroad_boston_famine",
   "title": "An Gorta M\u00f3r",
   "text": "From 1845 potato blight destroyed the crop that most of Ireland's poor lived on. Over the next seven years about a million people died of hunger and disease, and more than a million emigrated. Food was still being exported from Ireland while people starved, which is not forgotten."
  },
  {
   "x": 46,
   "y": 29,
   "plaque": "abroad_boston_black_47",
   "title": "Black '47",
   "text": "1847 was the worst year, Black '47. That year alone, tens of thousands of Irish emigrants landed in Boston, then a city of little over 100,000 people. Many came on overcrowded, disease-ridden vessels people called coffin ships. Many arrived sick."
  },
  {
   "x": 47,
   "y": 36,
   "plaque": "abroad_boston_deer_island",
   "title": "Deer Island",
   "text": "Boston set up a quarantine hospital on Deer Island, out in the harbour, in 1847. Thousands of sick emigrants were treated there, and hundreds who died were buried on the island. A memorial now stands for them."
  },
  {
   "x": 19,
   "y": 18,
   "plaque": "abroad_boston_kennedy",
   "title": "Patrick Kennedy",
   "text": "Patrick Kennedy, a farmer's son from Dunganstown in County Wexford, sailed for Boston in 1849 and became a cooper, making barrels. He died young, of cholera. His great-grandson, John F. Kennedy, became President of the United States in 1961 and visited Dunganstown in 1963."
  },
  {
   "x": 33,
   "y": 18,
   "plaque": "abroad_boston_faneuil",
   "title": "Faneuil Hall",
   "text": "A market and meeting hall since 1742, where Bostonians argued their way towards the American Revolution. Later, the Irish argued their way into the city's politics: by the 1880s Boston had an Irish-born mayor, Hugh O'Brien."
  },
  {
   "x": 26,
   "y": 27,
   "plaque": "abroad_boston_evacuation_day",
   "title": "Evacuation Day",
   "text": "On 17 March 1776 the British army left Boston after a siege. So 17 March is Evacuation Day in Boston as well as St Patrick's Day, and the parade in South Boston celebrates both. Nobody minds a second excuse."
  },
  {
   "x": 8,
   "y": 26,
   "plaque": "abroad_boston_american_wake",
   "title": "The American Wake",
   "text": "Before an emigrant left Ireland, the family held an American wake: a night of music, dancing and tears, like a wake for the dead, because most never expected to see them again. Many emigrants sent money home, paying the fare for the next brother or sister."
  },
  {
   "x": 30,
   "y": 30,
   "plaque": "abroad_boston_annie_moore",
   "title": "Meanwhile, in New York",
   "text": "On 1 January 1892 a 17-year-old from Cork, Annie Moore, became the first immigrant processed at the new Ellis Island station in New York harbour. There are statues of her at Ellis Island and at Cobh, the port she sailed from."
  }
 ],
