 "signs": [
  {
   "x": 65,
   "y": 12,
   "text": "PRIVATE MOSS. Do not feed the hermit. He has a pie."
  },
  {
   "x": 66,
   "y": 14,
   "text": "BRAMBLES. Someone lives past them. Possibly a hermit. Possibly a very shy accountant."
  },
  {
   "x": 69,
   "y": 24,
   "text": "CHAT MOSS. Seven miles of bog that swallowed three railway attempts. Stephenson won in the end."
  },
  {
   "x": 36,
   "y": 23,
   "text": "STEPHENSON'S RAILWAY, 1830. Built floating on heather, brushwood and a few tonnes of ambition."
  },
  {
   "x": 2,
   "y": 20,
   "text": "WEST: Liverpool, the Pier Head and a large number of birds. Keep hold of your chips."
  },
  {
   "x": 41,
   "y": 5,
   "text": "PEAT WORKINGS. Moss wasn't built in a day. It was built over eight thousand years. Please don't dig it all up in an afternoon."
  },
  {
   "x": 13,
   "y": 22,
   "text": "SPHAGNUM. Soaked up wounds in the First World War. Tougher than it looks. Wetter than it sounds."
  },
  {
   "x": 40,
   "y": 24,
   "plaque": "chat_moss_rainhill",
   "title": "The Rainhill Trials",
   "text": "In October 1829 the railway held a contest at Rainhill to choose its engines. The Stephensons' Rocket won, reaching nearly 30 miles an hour, while its rivals broke down or ran out of puff. The prize was 500 pounds, and the steam age had found its star."
  },
  {
   "x": 50,
   "y": 26,
   "plaque": "chat_moss_opening_day",
   "title": "Opening Day, 1830",
   "text": "The Liverpool and Manchester, the world's first inter-city passenger railway, opened on 15 September 1830 with the Duke of Wellington aboard. The day was darkened when the MP William Huskisson stepped onto the track and was struck by Rocket. He died that evening."
  }
 ],
