 "signs": [
  {
   "x": 27,
   "y": 18,
   "plaque": "abroad_roscoff_breizh",
   "title": "Breizh",
   "text": "Brittany, Breizh in Breton, is named after the Britons. Between about the 4th and the 7th centuries, people from south-west Britain, from Cornwall, Devon and Wales, crossed the sea and settled here, bringing their language. Bretagne and Great Britain share a name for a reason."
  },
  {
   "x": 25,
   "y": 26,
   "plaque": "abroad_roscoff_brezhoneg",
   "title": "Brezhoneg",
   "text": "Breton, Brezhoneg, is a Brythonic Celtic language: its closest relative is Cornish, and then Welsh. Count to five: unan, daou, tri, pevar, pemp. In Welsh: un, dau, tri, pedwar, pump. About two hundred thousand people speak it, most of them older, and UNESCO counts it as endangered."
  },
  {
   "x": 6,
   "y": 26,
   "plaque": "abroad_roscoff_johnnies",
   "title": "The Onion Johnnies",
   "text": "From 1828, men from Roscoff crossed to Britain each summer to sell the town's pink onions door to door, strung on poles and later hung from bicycles. The British called them Onion Johnnies. In the 1920s and 1930s there were well over a thousand of them."
  },
  {
   "x": 50,
   "y": 12,
   "plaque": "abroad_roscoff_ferries",
   "title": "Brittany Ferries",
   "text": "In the early 1970s Breton farmers led by Alexis Gourvennec wanted a quicker way to get their cauliflowers and artichokes to British shops, so they started their own ferry company. The first sailing, from Roscoff to Plymouth in January 1973, carried lorries of vegetables."
  },
  {
   "x": 6,
   "y": 18,
   "plaque": "abroad_roscoff_mary",
   "title": "Mary, Queen of Scots",
   "text": "In August 1548 a five-year-old girl stepped ashore at Roscoff: Mary, Queen of Scots, sent to France to be raised at the French court and, one day, marry the Dauphin. Nearly two hundred years later, in 1746, Bonnie Prince Charlie landed here too, after his escape from Scotland following Culloden."
  },
  {
   "x": 13,
   "y": 18,
   "plaque": "abroad_roscoff_kroaz_batz",
   "title": "The Stone Ships",
   "text": "The belfry of Notre-Dame de Kroaz Batz, built in the 16th century, is carved with stone ships and cannons, paid for by Roscoff's merchants and privateers. A town that lived off the sea put it on its church."
  },
  {
   "x": 30,
   "y": 12,
   "plaque": "abroad_roscoff_goemon",
   "title": "Gwemon",
   "text": "The Breton coast is one of Europe's great seaweed shores. For centuries go\u00e9moniers, seaweed gatherers, raked it from the rocks to fertilise the fields. Today it goes into food, cosmetics and medicine, and the Station Biologique, founded in 1872, studies everything that lives in it."
  },
  {
   "x": 47,
   "y": 26,
   "plaque": "abroad_roscoff_gwenn_ha_du",
   "title": "Gwenn ha Du",
   "text": "The Breton flag, Gwenn ha Du, white and black, was designed in 1923 by Morvan Marchal. Its five black stripes stand for the old dioceses of Upper Brittany, where French and Gallo were spoken, and its four white stripes for those of Lower Brittany, where Breton was. The corner is ermine."
  },
  {
   "x": 40,
   "y": 26,
   "plaque": "abroad_roscoff_diwan",
   "title": "Diwan",
   "text": "Since 1977 Diwan schools have taught children through Breton, from nursery up. Diwan means seed, or sprouting. The first school started with a handful of pupils; today thousands go, and they learn French, English and maths in Breton too."
  }
 ],
