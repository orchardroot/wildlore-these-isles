 "signs": [
  {
   "x": 34,
   "y": 28,
   "plaque": "fife_old_course",
   "title": "The Old Course",
   "text": "Golf has been played on these links since at least the early 1400s, which is why St Andrews is called the home of golf. In 1457 King James II banned golf and football because they kept men away from archery practice. It didn't take."
  },
  {
   "x": 21,
   "y": 27,
   "plaque": "fife_swilcan_bridge",
   "title": "The Swilcan Bridge",
   "text": "A little stone bridge over the Swilcan Burn on the 1st and 18th holes, hundreds of years old and built for shepherds and their flocks. Every golfer who plays the 18th stops on it for a photograph."
  },
  {
   "x": 17,
   "y": 17,
   "plaque": "fife_road_hole",
   "title": "The Road Hole",
   "text": "The 17th hole, named for the old road that runs beside its green. Its small, deep bunker in front of the green has wrecked the scores of champions. So has the road."
  },
  {
   "x": 26,
   "y": 15,
   "plaque": "fife_hell_bunker",
   "title": "Hell Bunker",
   "text": "The huge bunker on the 14th hole. Its steep face is built from stacked layers of turf, called revetting, rebuilt by hand. Golfers who go in are allowed to say what they like."
  },
  {
   "x": 27,
   "y": 34,
   "plaque": "fife_royal_ancient",
   "title": "The Royal and Ancient",
   "text": "The golf club was founded in 1754 as the Society of St Andrews Golfers, and became the Royal and Ancient in 1834. The clubhouse looks down the 1st and 18th fairways."
  },
  {
   "x": 43,
   "y": 33,
   "plaque": "fife_martyrs",
   "title": "The Martyrs' Monument",
   "text": "This obelisk on the Scores, put up in 1842, remembers the Protestant martyrs burned in St Andrews in the years before the Reformation of 1560."
  },
  {
   "x": 43,
   "y": 46,
   "plaque": "fife_cathedral",
   "title": "St Andrews Cathedral",
   "text": "Begun in 1158, it was the biggest church in medieval Scotland, the heart of the Scottish church. It fell into ruin after the Reformation, and townsfolk carried off its stones to build their houses."
  },
  {
   "x": 58,
   "y": 15,
   "plaque": "fife_castle",
   "title": "St Andrews Castle",
   "text": "The bishops' castle on the cliff. In 1546 Cardinal Beaton was murdered here and the castle besieged; the attackers dug a mine under it, the defenders dug a countermine to meet them, and you can still crawl through both. It also has a bottle dungeon."
  },
  {
   "x": 29,
   "y": 43,
   "plaque": "fife_ph_initials",
   "title": "The PH in the Cobbles",
   "text": "Outside St Salvator's the initials PH are set into the cobbles where Patrick Hamilton was burned for his Protestant beliefs in 1528. Students won't step on them: legend says if you do, you'll fail your degree."
  },
  {
   "x": 33,
   "y": 35,
   "plaque": "fife_university",
   "title": "The University",
   "text": "The University of St Andrews was founded in 1413, the oldest in Scotland and the third oldest in the English-speaking world, after Oxford and Cambridge."
  },
  {
   "x": 57,
   "y": 48,
   "plaque": "fife_pier_walk",
   "title": "The Pier Walk",
   "text": "On Sunday mornings in term, students in scarlet gowns walk out along the pier after chapel. On the way back, the way you wear your gown tells everybody which year you are in."
  },
  {
   "x": 36,
   "y": 8,
   "plaque": "fife_west_sands",
   "title": "The West Sands",
   "text": "Two miles of beach where the runners splash along in the opening scene of the 1981 film Chariots of Fire. Everyone who runs here hums the music. Everyone."
  },
  {
   "x": 2,
   "y": 35,
   "plaque": "fife_no_station",
   "title": "No Station",
   "text": "St Andrews lost its railway in 1969, so golfers, students and visitors come in by bus from Leuchars, a few miles away. The old station is a car park now. Ask a local to hum the departures."
  },
  {
   "x": 33,
   "y": 59,
   "text": "ST ANDREWS. NORTH: the Old Course, the castle, the cathedral. SOUTH: the Forth bridges."
  },
  {
   "x": 7,
   "y": 2,
   "text": "NORTH: Guardbridge, the Tay Road Bridge and Dundee."
  }
 ],
