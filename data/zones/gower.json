 "signs": [
  {
   "x": 81,
   "y": 19,
   "text": "G\u0174YR / GOWER. Rhossili 15 miles west. Penclawdd north. Abertawe (Swansea) behind you."
  },
  {
   "x": 78,
   "y": 22,
   "plaque": "swansea_aonb",
   "title": "First of its Kind",
   "text": "In 1956 Gower became the very first Area of Outstanding Natural Beauty in Britain. G\u0175yr in Welsh. Limestone cliffs, salt marsh, commons and bays, on a peninsula about fifteen miles long."
  },
  {
   "x": 30,
   "y": 37,
   "plaque": "swansea_worm",
   "title": "Worm's Head",
   "text": "The Worm takes its name from the Old Norse 'ormr', a serpent or dragon: Viking sailors saw a sea-dragon lying in the water. The causeway is only open for about two and a half hours either side of low tide. Check the tide table, or spend the night."
  },
  {
   "x": 25,
   "y": 21,
   "plaque": "swansea_helvetia",
   "title": "The Helvetia",
   "text": "The Norwegian barque Helvetia was blown ashore here in a gale in November 1887, with a cargo of timber. Nobody died. Her ribs have stuck out of Rhossili sands ever since, and the photographers love her."
  },
  {
   "x": 37,
   "y": 30,
   "plaque": "swansea_rhossili",
   "title": "Rhossili Bay",
   "text": "Three miles of sand under the heather of Rhossili Down, the highest point on Gower at 193 metres. It turns up on lists of the best beaches in the world, usually written by people who visited on a sunny day."
  },
  {
   "x": 47,
   "y": 41,
   "plaque": "swansea_paviland",
   "title": "The Red Lady of Paviland",
   "text": "In 1823 William Buckland dug a skeleton stained with red ochre from Goat's Hole cave here and called it the Red Lady. It was a young man, buried about 33,000 years ago with ivory and shells: the oldest known ceremonial burial in western Europe."
  },
  {
   "x": 61,
   "y": 36,
   "plaque": "swansea_threecliffs",
   "title": "Three Cliffs Bay",
   "text": "Three limestone pinnacles, a winding river called Pennard Pill and a beach that floods at high tide. Lovely to look at; foolish to swim in, because the currents at the river mouth are strong."
  },
  {
   "x": 74,
   "y": 36,
   "plaque": "swansea_pennard",
   "title": "Pennard Castle",
   "text": "A ruined castle on the dunes above Three Cliffs, lost to blowing sand in the Middle Ages. Legend says the lord insulted the Tylwyth Teg, the fair folk, at his wedding, and they buried it in a sandstorm overnight."
  },
  {
   "x": 52,
   "y": 19,
   "plaque": "swansea_arthur",
   "title": "Arthur's Stone",
   "text": "Maen Ceti: a Neolithic burial chamber on Cefn Bryn, around 5,000 years old, under a capstone of some twenty-five tons. Legend says King Arthur found a pebble in his boot and threw it here from Carmarthenshire."
  },
  {
   "x": 61,
   "y": 12,
   "plaque": "swansea_penclawdd",
   "title": "Penclawdd Cockles",
   "text": "Cockles have been gathered by hand on the sands of the Burry Inlet for centuries, once by women with donkeys and carts. They rake them, then riddle them through a sieve so the small ones fall back to grow. No dredges allowed."
  },
  {
   "x": 50,
   "y": 11,
   "plaque": "swansea_saltmarsh",
   "title": "Salt Marsh",
   "text": "The marsh along Gower's north shore floods on the big tides. Samphire and sea lavender grow here, and the sheep that graze it give the famous salt marsh lamb."
  },
  {
   "x": 46,
   "y": 21,
   "plaque": "swansea_ponies",
   "title": "Gower Ponies",
   "text": "Ponies graze the commons of Cefn Bryn and Fairwood all year round. They belong to commoners who have grazing rights, so they are not quite wild and not quite tame, and very definitely not to be fed."
  },
  {
   "x": 6,
   "y": 39,
   "text": "THE BLOWHOLE. When the tide is just right the sea booms up through the rock here, and the whole Outer Head shudders. The Vikings had a theory."
  }
 ],
