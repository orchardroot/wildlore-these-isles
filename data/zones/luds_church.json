 "signs": [
  {
   "x": 10,
   "y": 26,
   "plaque": "potteries_luds_church",
   "title": "Lud's Church",
   "text": "A chasm about 100 metres long and 18 metres deep, torn open by a landslip and lined with moss and ferns. Lollards, followers of the reformer John Wycliffe, are said to have worshipped down here in secret in the 1400s, out of sight of the bishops."
  },
  {
   "x": 12,
   "y": 12,
   "plaque": "potteries_green_chapel",
   "theme": "arts",
   "title": "The Green Chapel",
   "text": "Many think this is the Green Chapel of Sir Gawain and the Green Knight, a poem written in the late 1300s in a dialect from round here. A giant green knight lets Gawain cut off his head, picks it up, and tells him to come and take the return blow in a year."
  }
 ],
