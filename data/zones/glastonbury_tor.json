  {
   "id": "tor_reveller",
   "sprite": "festival_goer",
   "x": 13,
   "y": 7,
   "facing": "right",
   "move": "still",
   "text": "Came for the festival in 1997. Haven't found my tent. Haven't looked very hard either.",
   "hide_if": "trainer_keeper_morwen"
  },
  {
   "id": "tor_reveller_won",
   "sprite": "festival_goer",
   "x": 13,
   "y": 7,
   "facing": "right",
   "move": "still",
   "text": "The lanterns went out when she lost. Then came back on, sulking. Never seen that before.",
   "show_if": "trainer_keeper_morwen"
  },
  {
   "id": "tor_dowser",
   "sprite": "druid",
   "x": 27,
   "y": 7,
   "facing": "left",
   "move": "still",
   "text": "Don't step in the fairy ring. Or do. Morwen will find it very funny either way.",
   "hide_if": "trainer_keeper_morwen"
  },
  {
   "id": "tor_dowser_won",
   "sprite": "druid",
   "x": 27,
   "y": 7,
   "facing": "left",
   "move": "still",
   "text": "The ley lines just did a little skip. I think that's congratulations.",
   "show_if": "trainer_keeper_morwen"
  },
  {
   "id": "tor_tea",
   "sprite": "villager_6",
   "x": 22,
   "y": 4,
   "facing": "down",
   "move": "still",
   "text": "I bring Morwen a flask of nettle tea every Thursday. She says it's terrible. She drinks it all.",
   "hide_if": "trainer_keeper_morwen"
  },
  {
   "id": "tor_tea_won",
   "sprite": "villager_6",
   "x": 22,
   "y": 4,
   "facing": "down",
   "move": "still",
   "text": "She's asked for a second flask. I've never seen her ask for anything. You've rattled her.",
   "show_if": "trainer_keeper_morwen"
  }
 ],
 "encounters": {},
 "signs": [
  {
   "x": 13,
   "y": 26,
   "text": "THE ORCHARD. Old apple trees, older cider, and a feeling that something is watching. It's just the trees. Probably."
  },
  {
   "x": 30,
   "y": 25,
   "text": "THE TOR LOOKS OUT OVER THE LEVELS. In winter the fields flood and the hill becomes an island. That's Avalon. The word means 'apple island'."
  }
 ],
