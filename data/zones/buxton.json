 "encounters": {},
 "signs": [
  {
   "x": 29,
   "y": 11,
   "text": "ST ANN'S WELL. Warm spring water, 28 degrees, all year. Fill a bottle, everyone does."
  },
  {
   "x": 19,
   "y": 23,
   "text": "PAVILION GARDENS. Ducks have right of way."
  },
  {
   "x": 4,
   "y": 19,
   "text": "BUXTON. Welcome to the highest market town in England. Probably. Wrap up."
  },
  {
   "x": 29,
   "y": 5,
   "text": "NORTH: Goyt Valley and, eventually, Manchester. Take a coat. Manchester will not provide one."
  },
  {
   "x": 31,
   "y": 9,
   "text": "BLUE PLAQUE: Mary, Queen of Scots, took the waters at Buxton while a prisoner of the Earl of Shrewsbury in the 1570s and 1580s.",
   "kind": "plaque",
   "dx": -0.475,
   "plaque": "buxton_mary_queen_of_scots",
   "title": "Mary, Queen of Scots"
  },
  {
   "x": 19,
   "y": 12,
   "plaque": "buxton_devonshire_dome",
   "title": "The Devonshire Dome",
   "text": "Just behind the Crescent, John Carr built grand stables for visitors' horses. In 1881 the courtyard was roofed with a dome so wide it was said to be the largest unsupported dome in the world, bigger than St Paul's. It was a hospital for years; now students sit under it."
  },
  {
   "x": 31,
   "y": 12,
   "plaque": "buxton_name",
   "title": "Name: Buxton",
   "text": "Buxton probably comes from Old English 'bug-stanas', the rocking stones, after boulders that once balanced on the hills round about. Nobody has found one still rocking, so these days the town leaves the swaying to the Opera House crowd on the way home."
  },
  {
   "x": 40,
   "y": 35,
   "plaque": "buxton_solomons_temple",
   "title": "Solomon's Temple",
   "text": "Up on Grin Low, south of town, stands Solomon's Temple, a little stone tower built in 1896 by a local man called Solomon Mycock. It sits on top of a Bronze Age burial mound, so the view has been popular for about four thousand years."
  },
  {
   "x": 10,
   "y": 34,
   "plaque": "buxton_snow_stopped_play",
   "title": "Snow Stopped Play",
   "text": "On 2 June 1975 Derbyshire were playing Lancashire at cricket in Buxton when it snowed, properly, and play was called off. Snow stopping a county match in June is about as rare as cricket gets. Buxton would like you to know it was not even slightly surprised."
  },
  {
   "x": 25,
   "y": 35,
   "text": "CASTLETON, this way. Mam Tor, Peveril Castle and the only Blue John in the world. Take a torch. Or, better, a lantern."
  }
 ],
