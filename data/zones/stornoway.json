 "signs": [
  {
   "x": 30,
   "y": 11,
   "plaque": "hebrides_stornoway",
   "title": "Ste\u00f2rnabhagh",
   "text": "Stornoway's name is Norse: Stjornavagr, the steering bay, or the bay you steer into. In Gaelic it is Ste\u00f2rnabhagh. It is the only real town in the Western Isles, with a harbour that has sheltered boats for a thousand years."
  },
  {
   "x": 22,
   "y": 10,
   "plaque": "hebrides_lews_castle",
   "title": "Lews Castle",
   "text": "Sir James Matheson bought the whole of Lewis in 1844 with a fortune made in the China trade, and built this castle in the 1850s. Lord Leverhulme bought the island in 1918 with big plans, then gave the castle to the people of Stornoway in 1923. It now holds Museum nan Eilean."
  },
  {
   "x": 7,
   "y": 10,
   "plaque": "hebrides_castle_woods",
   "title": "The Castle Woods",
   "text": "The woods around Lews Castle were planted by the Mathesons, and they are one of the few real woods in the Outer Hebrides, where the wind and salt keep most trees down. Walk in them and you feel as if you've left the islands. Then you walk out and the wind says you haven't."
  },
  {
   "x": 28,
   "y": 12,
   "plaque": "hebrides_chessmen",
   "title": "The Lewis Chessmen",
   "text": "Ninety-three carved pieces, in walrus ivory and whale tooth, turned up at Uig in 1831. They were made in Norway in about 1150 to 1200. Most are in the British Museum and the National Museum of Scotland, and a few are shown on loan at Museum nan Eilean, home, near enough."
  },
  {
   "x": 27,
   "y": 18,
   "plaque": "hebrides_missing_knight",
   "title": "The Knight in the Drawer",
   "text": "One Lewis chessman went missing for nearly two centuries. A Scottish dealer bought a warder for a few pounds in 1964. His family kept it in a drawer, never knowing what it was, until it was recognised in 2019 and sold for hundreds of thousands of pounds. It is worth checking your drawers."
  },
  {
   "x": 44,
   "y": 18,
   "plaque": "hebrides_black_pudding",
   "title": "Stornoway Black Pudding",
   "text": "Stornoway Black Pudding is oatmeal, beef suet, onion and blood, shaped and cooked in a skin. It has protected geographical status, as Champagne does, so only the black pudding made in Stornoway can use the name. It is on every breakfast plate on the island, and a great many dinners."
  },
  {
   "x": 34,
   "y": 12,
   "plaque": "hebrides_orb_stornoway",
   "title": "The Orb Stamp",
   "text": "The Harris Tweed Authority, based here in Stornoway, inspects every length of Harris Tweed. Only cloth that has passed gets the Orb stamped on it, which is why a Harris Tweed jacket is a small piece of Hebridean law. The stamp goes on the cloth itself, not just the label."
  },
  {
   "x": 50,
   "y": 30,
   "plaque": "hebrides_gaelic",
   "title": "A Language, Alive",
   "text": "Around half the people of the Western Isles speak Gaelic, more than anywhere else in Scotland, and there are Gaelic road signs, schools, radio and television. Try 'Madainn mhath' (good morning), 'M\u00f2ran taing' (thank you very much) and 'Sl\u00e0inte mhath' (good health)."
  },
  {
   "x": 36,
   "y": 30,
   "plaque": "hebrides_sabbath",
   "title": "A Quiet Sunday",
   "text": "Many in Lewis keep Sunday as the Sabbath: a day for church and rest, with most shops shut and the streets quiet. Visitors are welcome to walk or just sit, and are asked to keep the day gently. The islanders will tell you the peace is the best part."
  },
  {
   "x": 38,
   "y": 42,
   "plaque": "hebrides_iolaire",
   "title": "HMY Iolaire",
   "text": "In the early hours of 1 January 1919 the yacht Iolaire, bringing home sailors from the First World War, struck rocks called the Beasts of Holm at the harbour mouth. More than 200 men were lost, within sight of home. A memorial stands at Holm, and the island remembers each New Year."
  },
  {
   "x": 52,
   "y": 34,
   "plaque": "hebrides_lanntair",
   "theme": "arts",
   "title": "An Lanntair",
   "text": "An Lanntair is Gaelic for the lantern, and it is the arts centre on the harbour here. It shows Gaelic and island art, music, film and theatre. Gaelic songs have been sung at every ceilidh in the islands, and the best ones are about the sea."
  },
  {
   "x": 66,
   "y": 11,
   "plaque": "hebrides_blue_men_plaque",
   "title": "The Blue Men of the Minch",
   "text": "The Minch is the stretch of water between the Outer Hebrides and the mainland, and the Blue Men (na fir ghorma) are said to live in the strait near the Shiant Isles. They swim up to boats and call out a line of verse. The skipper who can finish the rhyme gets through, and the rest are overturned."
  },
  {
   "x": 31,
   "y": 56,
   "text": "SOUTH: the road to Harris, Tairbeart (Tarbert) and the Skye ferry. F\u00c0ILTE GU STE\u00d2RNABHAGH: welcome to Stornoway."
  },
  {
   "x": 26,
   "y": 17,
   "text": "WEST: Lews Castle and the woods. EAST: the harbour. F\u00c0ILTE GU STE\u00d2RNABHAGH."
  }
 ],
