 "signs": [
  {
   "x": 30,
   "y": 9,
   "plaque": "sthelena_island",
   "title": "St Helena",
   "text": "One of the most remote inhabited islands on Earth, about 1,950 kilometres from the coast of Africa and 3,300 from South America. The Portuguese found it in 1502 and it was uninhabited. The East India Company settled it in 1659, which makes it Britain's second-oldest overseas territory, after Bermuda."
  },
  {
   "x": 24,
   "y": 16,
   "plaque": "sthelena_castle",
   "title": "The Castle",
   "text": "The oldest building in Jamestown still in use, built by the East India Company as its headquarters in the 1700s, and still full of government offices. It has a quiet garden at the back, and a wall with a very old well. Governors have come and gone over it for three centuries."
  },
  {
   "x": 37,
   "y": 16,
   "plaque": "sthelena_stjames",
   "title": "St James' Church",
   "text": "St James' Church, built in 1774, is said to be the oldest Anglican church in the southern hemisphere. It stands at the foot of the valley where the Saints, as the islanders call themselves, have been christened, married and buried for over two hundred years."
  },
  {
   "x": 15,
   "y": 40,
   "plaque": "sthelena_ladder",
   "title": "Jacob's Ladder",
   "text": "A flight of 699 steps straight up the cliff of Ladder Hill, built in 1829 to haul goods up to the fort on a cable railway, with a tramway of rails and a donkey, and workers to carry the rest. Today people race up it for fun. The record is in minutes, and in pain."
  },
  {
   "x": 36,
   "y": 22,
   "plaque": "sthelena_museum",
   "title": "The Museum of St Helena",
   "text": "A small museum in a former warehouse by the wharf, with maps, shipwreck finds and objects from the 1800s. One section is the Napoleon room. Another, more sobering, is about the thousands of enslaved Africans freed here by the Royal Navy in the 1800s."
  },
  {
   "x": 47,
   "y": 22,
   "plaque": "sthelena_consulate",
   "title": "The Consulate Hotel",
   "text": "Named for the Consul the Americans once had here, to support the ships that called in for water. The hotel in Jamestown remembers the days when a hundred ships a month came into the roads. It is also the place to eat a St Helena fishcake."
  },
  {
   "x": 25,
   "y": 32,
   "plaque": "sthelena_liberated",
   "title": "Liberated Africans",
   "text": "From 1840 to 1872 the Royal Navy's West Africa Squadron brought around 26,000 people freed from slave ships to St Helena, many of them in a terrible state. Rupert's Valley, just outside Jamestown, was their holding place, and many are buried there. Several became Saints, and their descendants are part of the island."
  },
  {
   "x": 38,
   "y": 32,
   "plaque": "sthelena_boats",
   "title": "Ships' Call",
   "text": "For three hundred years St Helena was a refuelling stop for ships heading round the Cape. Sailors called in for water, fresh vegetables and gossip. In 1815, with Napoleon on the island, it was guarded by a squadron of the Royal Navy, and nobody was allowed to land without a pass."
  },
  {
   "x": 30,
   "y": 40,
   "plaque": "sthelena_saints",
   "title": "The Saints",
   "text": "The islanders call themselves Saints. They are descended from English settlers, Africans, Indians, Chinese labourers and many others who ended up on the island. For most of its history the only way here was a ship from Cape Town, about five days away. The airport was finished in 2016, and regular flights began in 2017."
  }
 ],
