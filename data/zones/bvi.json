e": "fiddler", "x": 37, "y": 24, "facing": "down", "move": "still", "trainer": "bvi_scratch_t"}, {"id": "bvi_hunter", "sprite": "explorer", "x": 76, "y": 51, "facing": "up", "move": "still", "trainer": "bvi_hunter"}, {"id": "bvi_blackbeard", "sprite": "sailor", "x": 77, "y": 49, "facing": "left", "move": "still", "trainer": "bvi_blackbeard"}, {"id": "bvi_bureau", "sprite": "commuter", "x": 30, "y": 31, "facing": "down", "move": "still", "script": "bvi_bureau", "name": "Bureau Clerk"}, {"id": "bvi_homebound", "sprite": "sailor", "x": 31, "y": 31, "facing": "down", "move": "still", "script": "bvi_homebound", "name": "Movements Clerk"}], "encounters": {"grass": [{"species": "bathlet", "min": 95, "max": 97, "weight": 12}, {"species": "flamingale", "min": 95, "max": 97, "weight": 8}, {"species": "chipgull", "min": 95, "max": 97, "weight": 14}, {"species": "pinchkin", "min": 95, "max": 97, "weight": 14}, {"species": "duneskink", "min": 95, "max": 97, "weight": 12, "weather": ["clear", "sunshine"]}, {"species": "gannetling", "min": 95, "max": 97, "weight": 12}, {"species": "wideling", "min": 95, "max": 97, "weight": 10, "time": ["dawn", "dusk"]}, {"species": "parakit", "min": 95, "max": 97, "weight": 10}, {"species": "croakle", "min": 95, "max": 97, "weight": 10}, {"species": "swiftlet", "min": 95, "max": 97, "weight": 8, "weather": ["gale", "clear"]}, {"species": "rhonewraith", "min": 95, "max": 97, "weight": 4, "time": ["dusk", "night"], "weather": ["drizzle", "downpour", "gale"]}], "water": [{"species": "dolphlet", "min": 95, "max": 97, "weight": 26}, {"species": "swelklet", "min": 95, "max": 97, "weight": 22}, {"species": "pinchkin", "min": 95, "max": 97, "weight": 16}, {"species": "plungebeak", "min": 95, "max": 97, "weight": 14}, {"species": "baskling", "min": 95, "max": 97, "weight": 14}, {"species": "bathrock", "min": 96, "max": 98, "weight": 4}]}, "signs": [{"x": 36, "y": 34, "text": "ROAD TOWN, TORTOLA. Capital of the British Virgin Islands. Ferries, yachts and finance. Drive on the left, which is strange in a place that also takes US dollars."}, {"x": 60, "y": 33, "text": "THE BATHS, VIRGIN GORDA. House-sized granite boulders. Bring water shoes, a torch and a head for crawling."}, {"x": 13, "y": 18, "text": "JOST VAN DYKE. White Bay's this way. Customers swim in. We'd rather you didn't."}, {"x": 45, "y": 46, "text": "SALT ISLAND. Memorial to the Rhone. Please do not take the salt. It belongs to the Crown."}, {"x": 19, "y": 33, "text": "THE NAME. Columbus sailed past in 1493 and named the whole scatter of islands for St Ursula and her eleven thousand virgins, which was either devotion or a very tired pun. Sixty or so islands and cays carry the name today.", "plaque": "bvi_name", "title": "The Name"}, {"x": 62, "y": 31, "text": "THE BATHS. House-sized granite boulders on the shore of Virgin Gorda, tumbled and rounded by weathering, stack into caves, pools and passages that visitors crawl and wade through to Devil's Bay. They are granite formed deep underground, not volcanic rock.", "plaque": "bvi_baths", "title": "The Baths"}, {"x": 23, "y": 33, "text": "ROAD TOWN. 'Road' here is short for roadstead, a sheltered place to anchor ships, not for any road. The capital of the BVI grew up round the harbour, and today is a mix of ferries, charter yachts and company offices.", "plaque": "bvi_road_town", "title": "Road Town"}, {"x": 46, "y": 47, "text": "RMS RHONE. The Royal Mail steamer Rhone sank in a hurricane off Salt Island on 29 October 1867, with great loss of life. She lies broken in two in water up to about 25 metres deep, and is one of the finest dives in the Caribbean. The 1977 film The Deep was filmed in part on her wreck.", "plaque": "bvi_rhone", "title": "RMS Rhone"}, {"x": 48, "y": 49, "text": "SALT ISLAND. A small island with a salt pond, and a famous tradition: the settlers paid their rent to the Crown in salt, a pound a year. The island's tiny graveyard holds the dead of the Rhone.", "plaque": "bvi_salt_island", "title": "Salt Island"}, {"x": 56, "y": 26, "text": "ANEGADA. The name means drowned land in Spanish, and it fits: a flat coral island a few metres above the sea, unlike the volcanic hills of the rest of the BVI. Its reefs have wrecked hundreds of ships.", "plaque": "bvi_anegada", "title": "Anegada"}, {"x": 54, "y": 26, "text": "ANEGADA'S FLAMINGOS. Flamingos once lived right across the Caribbean, and were hunted out of the BVI. They were reintroduced in the 1990s and now stalk the salt ponds of Anegada in pink battalions.", "plaque": "bvi_flamingo", "title": "Anegada's Flamingos"}, {"x": 69, "y": 31, "text": "ANEGADA ROCK IGUANA. A large grey-brown iguana found only on Anegada, pushed to the edge of extinction by feral cats, goats and loss of habitat. Hatchlings are reared in a head-start programme and released.", "plaque": "bvi_iguana", "title": "Anegada Rock Iguana"}, {"x": 21, "y": 30, "text": "WILLIAM THORNTON. Born on Jost Van Dyke in 1759, he trained as a doctor in Britain, moved to America and in 1793 won the competition to design the US Capitol. A BVI man is the reason for the most famous dome in Washington.", "plaque": "bvi_thornton", "title": "William Thornton"}, {"x": 27, "y": 26, "text": "JOHN COAKLEY LETTSOM. Born on Little Jost Van Dyke in 1744, he trained as a doctor in Britain, set up in London and founded the Medical Society of London in 1773. He freed the slaves he inherited from his father's plantation.", "plaque": "bvi_lettsom", "title": "John Coakley Lettsom"}, {"x": 10, "y": 18, "text": "THE SOGGY DOLLAR. At White Bay on Jost Van Dyke there was no dock, so the first customers swam ashore and paid with wet money, hence the name. The bar is also credited as the birthplace of the Painkiller: rum, pineapple, orange and cream of coconut.", "plaque": "bvi_soggy", "title": "The Soggy Dollar"}, {"x": 74, "y": 47, "text": "DEAD CHEST ISLAND. Legend says Blackbeard marooned fifteen men on Dead Chest Island with a bottle of rum each. The story is said to have inspired the sea song 'Fifteen men on the dead man's chest' in Treasure Island.", "plaque": "bvi_dead_chest", "title": "Dead Chest Island"}, {"x": 40, "y": 33, "text": "BLACK TOT DAY. On 31 July 1970 the Royal Navy ended its daily rum ration, the tot, after more than three hundred years. Navy-style rum is still blended and sold in the BVI as Pusser's, named for the purser who once issued the tots.", "plaque": "bvi_black_tot", "title": "Black Tot Day"}, {"x": 34, "y": 23, "text": "FUNGI. Two things share this name in the BVI: a cornmeal-and-okra dish, and the music of the scratch bands, who play ukulele, gourd, washboard and a bass pipe. The dish is hot, the music is hotter.", "plaque": "bvi_fungi", "title": "Fungi"}, {"x": 50, "y": 34, "text": "SIR FRANCIS DRAKE CHANNEL. The strait between Tortola and the islands to the south is named for Drake, who sailed through in 1595 on his last voyage. It is now busy with charter yachts, all hoping to be Drake and none hoping to be seasick.", "plaque": "bvi_drake", "title": "Sir Francis Drake Channel"}, {"x": 76, "y": 52, "text": "NORMAN ISLAND. Said to have inspired Treasure Island, with caves where pirates are rumoured to have hidden loot. The caves are now a snorkelling spot and the only treasure on show is fish.", "plaque": "bvi_norman", "title": "Norman Island"}], "legend_extra": {"_water": {"deep": "#0a5a86", "deep_top": "#3ab8cc", "shallow": "#4cd6cc"}, "$": {"tile": "sea", "colour": "#12809e"}, "~": {"tile": "water", "colour": "#33b0be"}, "w": {"tile": "shallow", "colour": "#80e0d4"}, ".": {"tile": "grass", "colour": "#6aa83e"}, ",": {"tile": "tall_grass", "colour": "#58963a", "prop": "short"}, "s": {"tile": "sand", "colour": "#f4ead0"}, "p": {"tile": "sand", "colour": "#f6eed8"}, "t": {"tile": "tree_oak", "prop": "palm"}, "e": {"tile": "tree_oak", "prop": "palm"}, "r": {"tile": "rock", "colour": "#b0a894"}, "g": {"tile": "rock", "colour": "#a9a398", "prop": "gritstone"}, "#": {"tile": "path", "colour": "#e4d6b4"}, 