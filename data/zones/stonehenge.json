  {
   "id": "moot_druid",
   "sprite": "druid",
   "x": 26,
   "y": 41,
   "facing": "up",
   "move": "still",
   "text": "The Moot only sits once a generation. My nan saw the last one. She said the Winds were showing off.",
   "hide_if": "champion"
  },
  {
   "id": "moot_druid_won",
   "sprite": "druid",
   "x": 26,
   "y": 41,
   "facing": "up",
   "move": "still",
   "text": "A new Champion! I'll ring my nan. She'll say the last one was better. She's wrong.",
   "show_if": "champion"
  },
  {
   "id": "moot_reveller",
   "sprite": "festival_goer",
   "x": 34,
   "y": 41,
   "facing": "up",
   "move": "still",
   "text": "I came for the solstice and nobody told me there'd be a tournament. Best mistake I've made.",
   "hide_if": "champion"
  },
  {
   "id": "moot_reveller_won",
   "sprite": "festival_goer",
   "x": 34,
   "y": 41,
   "facing": "up",
   "move": "still",
   "text": "That's the Champion! Can I have a selfie? With the stones. You can be in it too.",
   "show_if": "champion"
  },
  {
   "id": "moot_farmer",
   "sprite": "farmer",
   "x": 18,
   "y": 30,
   "facing": "right",
   "move": "still",
   "text": "The Winds get sharp when the Moot sits. Last time my hat ended up in Salisbury.",
