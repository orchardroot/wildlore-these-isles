 "signs": [
  {
   "x": 56,
   "y": 42,
   "plaque": "fife_discovery",
   "title": "RRS Discovery",
   "text": "Built here in Dundee and launched in 1901 to carry Captain Scott and Ernest Shackleton on their first Antarctic expedition, with a hull nearly two feet thick to stand the ice. She came home to Dundee in 1986."
  },
  {
   "x": 44,
   "y": 43,
   "plaque": "fife_vanda",
   "title": "V&A Dundee",
   "text": "Scotland's design museum opened in 2018. The Japanese architect Kengo Kuma based it on the cliffs of the north-east coast. Inside is a whole tearoom by Charles Rennie Mackintosh, the Oak Room, rebuilt piece by piece."
  },
  {
   "x": 2,
   "y": 41,
   "plaque": "fife_tay_disaster",
   "title": "The Tay Bridge Disaster",
   "text": "On the stormy night of 28 December 1879 the middle of the first Tay Bridge blew down while a train was crossing. Nobody aboard survived. The stumps of its piers still stand in the water beside the second bridge."
  },
  {
   "x": 24,
   "y": 41,
   "plaque": "fife_tay_rail_bridge",
   "title": "The Tay Bridge",
   "text": "The second Tay Bridge opened in 1887, built much more strongly beside the line of the first. It's over three kilometres long, the longest railway bridge in Britain."
  },
  {
   "x": 44,
   "y": 36,
   "plaque": "fife_tay_road_bridge",
   "title": "The Tay Road Bridge",
   "text": "Opened in 1966, more than two kilometres of road from Fife into Dundee, with a footpath running down the middle between the two carriageways."
  },
  {
   "x": 30,
   "y": 29,
   "plaque": "fife_mcgonagall",
   "theme": "arts",
   "title": "William McGonagall",
   "text": "Dundee's own poet, often called the worst in the English language. His poem about the bridge disaster ends 'the stronger we our houses do build, the less chance we have of being killed'. He gave readings; audiences threw peas. He carried on."
  },
  {
   "x": 17,
   "y": 25,
   "plaque": "fife_jute",
   "title": "Juteopolis",
   "text": "Dundee spun jute from India, softened with whale oil from the town's own whaling ships, into sacks, sandbags and carpet backing. Most of the mill workers were women, and the town was nicknamed Juteopolis."
  },
  {
   "x": 26,
   "y": 28,
   "plaque": "fife_jam",
   "title": "Jute, Jam and Journalism",
   "text": "Keiller's of Dundee made marmalade famous across the world. With the jute and DC Thomson's papers and comics, it gave the city its old motto: jute, jam and journalism."
  },
  {
   "x": 36,
   "y": 28,
   "plaque": "fife_comics",
   "title": "The Comics",
   "text": "DC Thomson in Dundee has published The Dandy and The Beano since the 1930s. That's Desperate Dan in bronze, striding across the City Square since 2001, with his dog Dawg at his heels."
  },
  {
   "x": 14,
   "y": 5,
   "plaque": "fife_law",
   "title": "Dundee Law",
   "text": "The Law, 174 metres high, is the stump of an old volcano, with a war memorial on top and the best view of the Tay. 'Law' is the Scots word for a hill."
  },
  {
   "x": 47,
   "y": 22,
   "plaque": "fife_city_of_design",
   "title": "City of Design",
   "text": "In 2014 Dundee became the UK's first UNESCO City of Design. The city also gave the world a lot of video games: Lemmings and Grand Theft Auto both started here."
  },
  {
   "x": 50,
   "y": 27,
   "plaque": "fife_mary_shelley",
   "theme": "arts",
   "title": "Mary Shelley",
   "text": "As a teenager, Mary Shelley spent two summers in Dundee, round about 1812. She later wrote that it was here, by the Tay, that her imagination first ran free. A few years after, she wrote Frankenstein."
  },
  {
   "x": 42,
   "y": 62,
   "text": "DUNDEE. The City of Discovery. Over the bridge, south: St Andrews and Fife."
  }
 ],
