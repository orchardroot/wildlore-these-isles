   ],
   "fact": "Game birds of different genera do sometimes cross. Capercaillie and willow grouse young are on record in Scandinavia, and they are rare and sterile."
  },
  "Bovidae": {
   "pairs": [
    [
     "Capra",
     "Ovis"
    ]
   ],
   "fact": "Sheep have 54 chromosomes and goats 60. A live sheep and goat cross is on record only a handful of times."
  },
  "Leporidae": {
   "why": "A hare and a rabbit look like cousins, but they are different genera, 48 chromosomes against 44, and nobody has ever had young from them."
  },
  "Mustelidae": {
   "why": "Stoats, martens, mink, otters and badgers are all one family, but different genera, and they don't cross."
  }
