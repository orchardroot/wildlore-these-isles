{
 "garside": [
  {
   "do": "if",
   "flag": "starter",
   "then": [
    {
     "do": "if",
     "flag": "fieldbook_25",
     "else": [
      {
       "do": "when",
       "cond": "caught_25",
       "then": [
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Hold on. Let me see that Fieldbook. Twenty-five caught already? It's getting heavy, {player}. Good."
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "An acorn from the old oak outside, and some Iron Snares. Give the acorn to someone sturdy. Mighty oaks, little acorns. I'll stop."
        },
        {
         "do": "give_item",
         "item": "oak_acorn"
        },
        {
         "do": "give_item",
         "item": "iron_snare",
         "n": 5
        },
        {
         "do": "set",
         "flag": "fieldbook_25"
        }
       ]
      }
     ]
    },
    {
     "do": "if",
     "flag": "fieldbook_50",
     "else": [
      {
       "do": "when",
       "cond": "caught_50",
       "then": [
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Fifty! Half a hundred, {player}. I found this four-leaf clover in 1987 and I've been saving it for someone who deserved it."
        },
        {
         "do": "give_item",
         "item": "four_leaf_clover"
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Give it to your lead. Snares seem to hold better with a bit of luck about. Don't ask me why. I've stopped asking."
        },
        {
         "do": "set",
         "flag": "fieldbook_50"
        }
       ]
      }
     ]
    },
    {
     "do": "if",
     "flag": "fieldbook_100",
     "else": [
      {
       "do": "when",
       "cond": "caught_100",
       "then": [
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "One hundred caught. A century! At the cricket they'd stand and clap. I'm standing. I'm clapping. The owl is unimpressed."
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "A Brigid's cross, woven from rushes, and a few Silver Snares. Don't tell the university what they cost."
        },
        {
         "do": "give_item",
         "item": "brigid_cross"
        },
        {
         "do": "give_item",
         "item": "silver_snare",
         "n": 3
        },
        {
         "do": "set",
         "flag": "fieldbook_100"
        }
       ]
      }
     ]
    },
    {
     "do": "if",
     "flag": "fieldbook_150",
     "else": [
      {
       "do": "when",
       "cond": "caught_150",
       "then": [
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "A hundred and fifty. I had to count twice, then make a cup of tea, then count again."
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "This horseshoe came off a pony who outlived three vicars. Luck clings to it. So does a smell, but mostly luck."
        },
        {
         "do": "give_item",
         "item": "horseshoe"
        },
        {
         "do": "set",
         "flag": "fieldbook_150"
        }
       ]
      }
     ]
    },
    {
     "do": "fieldbook_news",
     "who": "Prof. Garside"
    }
   ]
  },
  {
   "do": "if",
   "flag": "game_complete",
   "then": [
    {
     "do": "choice",
     "text": "What would you like to do?",
     "options": [
      "Show Garside the Fieldbook",
      "Ask for a rematch",
      "Just say hello"
     ],
     "set": "garside_pick"
    },
    {
     "do": "if",
     "flag": "garside_pick",
     "eq": 0,
     "then": [
      {
       "do": "if",
       "flag": "fieldbook_diploma_given",
       "then": [
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "It's framed on the wall, {player}. {total} out of {total}. I tell the pigeons about it. They are not impressed."
        }
       ],
       "else": [
        {
         "do": "when",
         "cond": "caught_all",
         "then": [
          {
           "do": "say",
           "who": "Prof. Garside",
           "text": "Let me see. Oh. Oh, my. One. Two. Three. I shall need to sit down. I may need a kettle."
          },
          {
           "do": "say",
           "who": "Prof. Garside",
           "text": "All {total}. Every last creature, in one Fieldbook. Wet pages, coffee stains and all."
          },
          {
           "do": "say",
           "who": "Prof. Garside",
           "text": "I have spent forty years on these islands and I have never seen it done. Not once. Not by me, not by my old tutor, not by anybody."
          },
          {
           "do": "say",
           "who": "Prof. Garside",
           "text": "You went to every stone, every lake, every mud patch. You were kind to things that didn't deserve it, and firm with things that did."
          },
          {
           "do": "say",
           "who": "Prof. Garside",
           "text": "I'm so proud of you I can't even manage a joke. Here. This is for you. It's a diploma. I made it myself. The stamp is a potato."
          },
          {
           "do": "set",
           "flag": "fieldbook_diploma_given"
          },
          {
           "do": "give_item",
           "item": "fieldbook_diploma"
          },
          {
           "do": "say",
           "who": "Prof. Garside",
           "text": "Hang it somewhere with good light. Or give it to your mum. She'll hang it somewhere with excellent light."
          }
         ],
         "else": [
          {
           "do": "say",
           "who": "Prof. Garside",
           "text": "Let me see. {caught} caught of {total}. That leaves {left} still out there."
          },
          {
           "do": "say",
           "who": "Prof. Garside",
           "text": "Don't fret. Some of them only come out in certain weather, or at certain times, or when you've stopped looking. They're shy. So am I."
          }
         ]
        }
       ]
      }
     ],
     "else": [
      {
       "do": "if",
       "flag": "garside_pick",
       "eq": 1,
       "then": [
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "A rematch? Wonderful. I've kept my team in excellent shape. It's the only exercise I take."
        },
        {
         "do": "choice",
         "text": "A rematch with Prof. Garside?",
         "options": [
          "Yes, a rematch",
          "Not today"
         ],
         "set": "rematch_pick"
        },
        {
         "do": "if",
         "flag": "rematch_pick",
         "eq": 0,
         "then": [
          {
           "do": "daily",
           "key": "rematch_prof_garside",
           "then": [
            {
             "do": "battle",
             "trainer": "prof_garside_rematch",
             "intro": true
            }
           ],
           "else": [
            {
             "do": "say",
             "who": "Prof. Garside",
             "text": "Once a day, I'm afraid. Even I can only lose to a student so often. Come back tomorrow."
            }
           ]
          }
         ],
         "else": [
          {
           "do": "say",
           "who": "Prof. Garside",
           "text": "Another time. The offer stands, and so does the kettle."
          }
         ]
        }
       ],
       "else": [
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Hello, {player}. The Field Station's rather quiet without the stones humming. I find I miss it. Don't tell anybody."
        }
       ]
      }
     ]
    }
   ],
   "else": [
    {
     "do": "if",
     "flag": "snares_given",
     "then": [
      {
       "do": "if",
       "flag": "job_epoch",
       "then": [],
       "else": [
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Have you looked at the noticeboard in the market? Odd jobs. Good for the legs, and folk remember a helpful face."
        }
       ]
      },
      {
       "do": "say",
       "who": "Prof. Garside",
       "text": "East through the Forest, then the Cat and Fiddle road to Buxton."
      },
      {
       "do": "say",
       "who": "Prof. Garside",
       "text": "Keeper Maud has the first Stone. And take a coat. The moor has opinions."
      }
     ],
     "else": [
      {
       "do": "if",
       "flag": "garside_met",
       "then": [
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Back for your creature? Take your time. They won't mind."
        }
       ],
       "else": [
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "{player}! Thank goodness. Come in, mind the kettle, mind the owl pellets."
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Can you hear it? That low hum? That's the stones. All of them, everywhere."
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "The old legends are waking up, and every creature in the Peak can feel it."
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "This morning I found a heron in the kettle. Not as a metaphor."
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "I need someone to go and have a look, and that someone has legs. Yours."
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "First, this. A Fieldbook. It fills in as you meet creatures. Mind the coffee stains."
        },
        {
         "do": "give_item",
         "item": "fieldbook"
        },
        {
         "do": "set",
         "flag": "garside_met"
        }
       ]
      },
      {
       "do": "say",
       "who": "Prof. Garside",
       "text": "Now, you can't go out there alone. Choose one of these three."
      },
      {
       "do": "starter"
      },
      {
       "do": "if",
       "flag": "starter",
       "then": [
        {
         "do": "if",
         "flag": "starter",
         "then": [
          {
           "do": "say",
           "who": "Prof. Garside",
           "text": "A Spikkin! Prickly, loyal and brilliant at parties nobody wanted."
          }
         ],
         "eq": "spikkin"
        },
        {
         "do": "if",
         "flag": "starter",
         "then": [
          {
           "do": "say",
           "who": "Prof. Garside",
           "text": "A Holtling! Curious, damp and better at fishing than I am."
          }
         ],
         "eq": "holtling"
        },
        {
         "do": "if",
         "flag": "starter",
         "then": [
          {
           "do": "say",
           "who": "Prof. Garside",
           "text": "A Kindlet! Warm, quick and absolutely not safe near the curtains."
          }
         ],
         "eq": "kindlet"
        },
        {
         "do": "if",
         "flag": "starter",
         "then": [
          {
           "do": "set",
           "flag": "kit_vs_spikkin"
          }
         ],
         "eq": "spikkin"
        },
        {
         "do": "if",
         "flag": "starter",
         "then": [
          {
           "do": "set",
           "flag": "kit_vs_holtling"
          }
         ],
         "eq": "holtling"
        },
        {
         "do": "if",
         "flag": "starter",
         "then": [
          {
           "do": "set",
           "flag": "kit_vs_kindlet"
          }
         ],
         "eq": "kindlet"
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Now, take these as well. Five Wicker Snares, woven by hand."
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Slightly itchy, entirely legal. Weaken a wild creature, then throw one."
        },
        {
         "do": "give_item",
         "item": "wicker_snare",
         "n": 5
        },
        {
         "do": "set",
         "flag": "snares_given"
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Now go east, through Macclesfield Forest. Cat and Fiddle road, then Buxton."
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Keeper Maud has the first Stone there. She'll want to see you look after a creature."
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Ten Keepers, ten Stones, one for each old legend. Beat a Keeper fairly and you earn theirs. Press Esc any time for your Fieldbook, bag and map."
        },
        {
         "do": "move",
         "npc": "kit",
         "path": [
          "left"
         ]
        },
        {
         "do": "face_player",
         "npc": "kit"
        },
        {
         "do": "say",
         "who": "{rival}",
         "text": "Hang on! Not so fast, {player}!"
        },
        {
         "do": "say",
         "who": "{rival}",
         "text": "I've been waiting ALL morning for this. And I've got my phone ready."
        },
        {
         "do": "if",
         "flag": "starter",
         "then": [
          {
           "do": "say",
           "who": "{rival}",
           "text": "Oooh, a Spikkin! Right, I'll have the Kindlet then."
          },
          {
           "do": "say",
           "who": "{rival}",
           "text": "Hearth beats Hedgerow. That's not cheating, that's science."
          }
         ],
         "eq": "spikkin"
        },
        {
         "do": "if",
         "flag": "starter",
         "then": [
          {
           "do": "say",
           "who": "{rival}",
           "text": "A Holtling? Cute! I'll take the Spikkin, then."
          },
          {
           "do": "say",
           "who": "{rival}",
           "text": "Hedgerow beats Brook. Probably. Let's find out."
          }
         ],
         "eq": "holtling"
        },
        {
         "do": "if",
         "flag": "starter",
         "then": [
          {
           "do": "say",
           "who": "{rival}",
           "text": "A Kindlet? Brave, with all these curtains. I'll have the Holtling."
          },
          {
           "do": "say",
           "who": "{rival}",
           "text": "Brook beats Hearth. See? I did revise."
          }
         ],
         "eq": "kindlet"
        },
        {
         "do": "say",
         "who": "{rival}",
         "text": "Right! Battle! Now! Before I overthink it!"
        },
        {
         "do": "set",
         "flag": "kit1_fought"
        },
        {
         "do": "if",
         "flag": "starter",
         "then": [
          {
           "do": "battle",
           "trainer": "kit_1_vs_spikkin"
          }
         ],
         "eq": "spikkin"
        },
        {
         "do": "if",
         "flag": "starter",
         "then": [
          {
           "do": "battle",
           "trainer": "kit_1_vs_holtling"
          }
         ],
         "eq": "holtling"
        },
        {
         "do": "if",
         "flag": "starter",
         "then": [
          {
           "do": "battle",
           "trainer": "kit_1_vs_kindlet"
          }
         ],
         "eq": "kindlet"
        },
        {
         "do": "say",
         "who": "{rival}",
         "text": "Good one! That's going on my channel. Both halves of it."
        },
        {
         "do": "say",
         "who": "{rival}",
         "text": "I'm off to Buxton to see the spa! Race you there, {player}!"
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Hm. I do hope there's a Fieldbook entry for 'overexcitable'."
        },
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Oh, and on your way: the parish noticeboard by the market. The Forest Rangers want a rabbit counted. Catch one in the Forest and it pays for itself."
        }
       ],
       "else": [
        {
         "do": "say",
         "who": "Prof. Garside",
         "text": "Shy? Quite understood. Come back when you've made up your mind."
        },
        {
         "do": "end"
        }
       ]
      }
     ]
    }
   ]
  }
 ],
 "kit_station": [
  {
   "do": "if",
   "flag": "game_complete",
   "then": [
    {
     "do": "say",
     "who": "{rival}",
     "text": "{player}! Look at us, back at the Field Station like nothing happened. Like we didn't save the islands. Casual."
    },
    {
     "do": "choice",
     "text": "A rematch with {rival}?",
     "options": [
      "Yes, a rematch",
      "Not today"
     ],
     "set": "rematch_pick"
    },
    {
     "do": "if",
     "flag": "rematch_pick",
     "eq": 0,
     "then": [
      {
       "do": "daily",
       "key": "rematch_kit",
       "then": [
        {
         "do": "if",
         "flag": "kit_vs_spikkin",
         "then": [
          {
           "do": "battle",
           "trainer": "kit_rematch_vs_spikkin",
           "intro": true
          }
         ],
         "else": [
          {
           "do": "if",
           "flag": "kit_vs_holtling",
           "then": [
            {
             "do": "battle",
             "trainer": "kit_rematch_vs_holtling",
             "intro": true
            }
           ],
           "else": [
            {
             "do": "battle",
             "trainer": "kit_rematch_vs_kindlet",
             "intro": true
            }
           ]
          }
         ]
        }
       ],
       "else": [
        {
         "do": "say",
         "who": "{rival}",
         "text": "Once a day! My team's got a union. Tomorrow, I promise. I'll bring snacks."
        }
       ]
      }
     ],
     "else": [
      {
       "do": "say",
       "who": "{rival}",
       "text": "Fair enough. I'll be here. Practising. Dramatically."
      }
     ]
    }
   ],
   "else": [
    {
     "do": "if",
     "flag": "kit1_fought",
     "then": [
      {
       "do": "say",
       "who": "{rival}",
       "text": "Don't gloat. Okay, gloat a bit. I'd gloat."
      },
      {
       "do": "say",
       "who": "{rival}",
       "text": "I'm heading to Buxton. If I trend, remember who taught you cameras."
      }
     ],
     "else": [
      {
       "do": "say",
       "who": "{rival}",
       "text": "Garside's giving out creatures! I'm filming it for my followers."
      },
      {
       "do": "say",
       "who": "{rival}",
       "text": "I've got eleven followers. Two are my mum. One's my mum's other account."
      }
     ]
    }
   ]
  }
 ],
 "intern": [
  {
   "do": "say",
   "who": "Intern",
   "text": "I've been sorting owl pellets since six. Never again."
  },
  {
   "do": "say",
   "who": "Intern",
   "text": "The creatures keep gathering outside the window. Like an audience."
  }
 ]
}
